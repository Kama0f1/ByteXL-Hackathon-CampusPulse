# Copy to backend/.env. Never commit real keys.
# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# On Railway, point this at the attached volume. Local default remains backend/interventions_store.json.
# CAMPUS_STORE_PATH=/campus-store/interventions_store.json
